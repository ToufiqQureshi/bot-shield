# Supabase project used for auth (signup, signin, email verification,
# password reset) and, together with the Go backend's -db-url, as this
# dashboard's database. Get these from your Supabase project's API
# settings (Project Settings > API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the hakaishield backend's domains/rules/settings API.
# Required outside local development. Use the public HTTPS pilot hostname.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Actual operator inbox for pilot setup requests. Leave blank until an inbox
# exists; the contact page will then show no send action.
VITE_PILOT_CONTACT_EMAIL=
