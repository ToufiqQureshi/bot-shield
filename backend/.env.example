# Copy to .env (gitignored) and fill in real values. Loaded
# automatically at startup (main.go's loadDotEnv) without overriding
# real shell/deployment env vars if they're already set.

# Supabase project's Postgres connection string (Project Settings ->
# Database -> Connection string in the Supabase dashboard). Needed,
# with SUPABASE_URL, to enable the domains/rules/settings API.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require

# Your Supabase project URL — used to verify dashboard session JWTs
# against that project's published JWKS.
SUPABASE_URL=https://your-project-ref.supabase.co
